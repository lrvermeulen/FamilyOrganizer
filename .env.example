# Wachtwoord van het gezin. Zonder dit draait de app als demo met een voorbeeldgezin.
GEZIN_WACHTWOORD=
# Willekeurige tekst van minstens 32 tekens, voor het ondertekenen van de inlogcookie.
SESSION_SECRET=
# Opslag (zet Vercel zelf als je Upstash koppelt via de Marketplace).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Geheim voor de klok (/api/klok) die de ochtendbriefing en herinneringen verstuurt.
CRON_SECRET=
# Optioneel: eigen sleutels voor pushmeldingen. Zonder deze maakt de app ze zelf aan en bewaart ze in de opslag.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
